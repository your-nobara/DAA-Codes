PRACTICAL NO : 01
Write a program non-recursive and recursive program to calculate Fibonacci numbers and 
analyze their time and space complexity. 
CODE : 
#include <iostream> 
using namespace std; 
int fibonacci(int n) 
{ 
    if (n <= 1) 
    { 
        return n; 
    } 
    return fibonacci(n - 1) + fibonacci(n - 2); 
}  
int main() 
{ 
    int i, n, f0 = 0, f1 = 1, next; 
    cout << "Fibonacci Series in C++ Without Using Recursion"; 
    cout << "\nEnter any number: "; 
    cin >> n; 
    for (i = 0; i < n; i++) 
    { 
        cout << f0 << " "; 
        next = f0 + f1; 
        f0 = f1; 
        f1 = next; 
    } 
    cout << "\n\nFibonacci Series in C++ Using Recursion"; 
    cout << "\nEnter any number: "; 
    cin >> n; 
    for (i = 0; i < n; i++) 
    { 
        cout << fibonacci(i) << " "; 
    } 
    return 0; 
}
