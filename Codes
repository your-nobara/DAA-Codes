PRACTICAL NO : 02 
Write a program to implement Huffman Encoding using a greedy strategy. 
CODE :

#include <iostream>
#include <queue>
#include <vector>
using namespace std;

struct Node
{
    char ch;
    int freq;
    int order;
    Node *left, *right;

    Node(char c, int f, int o)
    {
        ch = c;
        freq = f;
        order = o;
        left = right = NULL;
    }
};

struct Compare
{
    bool operator()(Node* a, Node* b)
    {
        if (a->freq == b->freq)
            return a->order > b->order;

        return a->freq > b->freq;
    }
};

void printCodes(Node* root, string code)
{
    if (root == NULL)
        return;

    if (root->left == NULL && root->right == NULL)
    {
        if (code == "")
            code = "0";

        cout << root->ch << ": " << code << endl;
        return;
    }

    printCodes(root->left, code + "0");
    printCodes(root->right, code + "1");
}

int main()
{
    priority_queue<Node*, vector<Node*>, Compare> pq;

    int n, freq, order = 0;
    char ch;

    cout << "Enter number of characters: ";
    cin >> n;

    if (n <= 0)
        return 0;

    cout << "Enter character and frequency:\n";

    for (int i = 0; i < n; i++)
    {
        cin >> ch >> freq;
        pq.push(new Node(ch, freq, order++));
    }

    while (pq.size() > 1)
    {
        Node* left = pq.top();
        pq.pop();

        Node* right = pq.top();
        pq.pop();

        Node* parent = new Node(
            '$',
            left->freq + right->freq,
            order++
        );

        parent->left = left;
        parent->right = right;

        pq.push(parent);
    }

    cout << "\nHuffman Codes:\n";
    printCodes(pq.top(), "");

    return 0;
}
